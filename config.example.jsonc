{
  // 书籍根目录：只扫描每一项的一层子目录。
  // 某个子目录里有 config_mdr.jsonc，才会在首页显示为一本书。
  // 主配置里可写字符串（单个目录）或字符串数组（多个目录，按顺序扫描）。
  // 相对路径相对本文件所在目录；也可以写绝对路径。
  // 多个根下若出现同名书籍目录，后出现的会自动改 id，避免覆盖。
  "booksRoot": [
    "./Books"
    // , "../OtherBooks"
  ],

  // 补充书籍配置：直接指向书籍定义文件，文件名不必是 config_mdr.jsonc。
  // 必须是数组。项为相对本文件的路径（或绝对路径），支持通配符 * ? **。
  // 内容需符合 config_mdr.jsonc 的字段格式，否则忽略。
  // 书的 id 用该文件名（去掉 .jsonc / .json）。同一目录下多本书不会再共用目录名当 id。
  "booksCfg": [
    // "./Books/cfgs/*.jsonc"
    // , "../XXX/my-book.jsonc"
  ]

  // 接力：在每个 booksRoot 目录自身及其一层子目录里查找 config.jsonc。
  // 只合并对方的数组字段（目前是 booksRoot、booksCfg），按真实路径去重并继续接力。
  // 对方写的非数组字段（以及主配置未定义的其它标量/对象）一律以本文件为准，不会被覆盖。
  //
  // 本文件、接力 config.jsonc、书籍配置（config_mdr.jsonc / booksCfg）改完即热更新，无需重启。
  // 端口等进程级设置除外（当前端口由启动参数 --port 决定）。
}
