{
  // 首页卡片和阅读页顶栏显示的书名。不填则用该 config 所在文件夹的名字。
  "name": "XXX",

  // 封面图，路径相对本文件所在目录，也可以写到目录外（例如 "../XXX/cover.png"）。
  // 只认这一项，不会自动去找 cover.png。不填或文件不存在时，首页用默认占位封面。
  "cover": "./cover.jpg",

  // 书籍正文根目录，相对本文件所在目录，拼成绝对路径后扫其中的 .md。
  // 可写字符串（单个根）或字符串数组（多个根，侧栏会合并；同路径文件以先写的为准）。
  // "." = 本文件所在目录就是书根。
  // 若本文件只是「书卡」、正文在别处，改成指向书根的相对路径，例如 "../../../XXX"。
  "path": [
    "."
    // , "../ExtraChapters"
  ],

  // 首页卡片上、书名下方的信息，按这里的书写顺序逐行展示。
  // key = 左侧标题，value = 右侧内容。卡片最多显示 3 行，多出显示 "..."；
  // 单行超出封面宽度会省略，鼠标悬停可看全文。
  // 首页搜索会匹配书名以及这里的 key / value（例如搜「作者」或「XXX」）。
  "meta": {
    "作者": "XXX",
    "版本": "1.0",
    "说明": "示例元信息"
  },

  // 相对「path 指向的书根」要排除的目录或文件，不出现在侧栏和书内搜索。
  // 支持通配符：* 匹配一段，** 匹配多层，? 匹配单个字符。
  // .git / .vscode / node_modules / 点目录 会始终排除，不必写。
  "exclude": [
    "Src/**",
    "**/node_modules/**"
  ],

  // 侧栏展示方式。两项都可不写，默认 false（只显示文件名 / 目录名）。
  "features": {
    // true：侧栏文件行主标题用该 md 的一级标题（# 开头那行）；
    // 没有一级标题则退回文件名。文件名（去掉 .md）显示为灰色副标题。
    "UseTitleAsFileName": true,

    // true：侧栏目录行主标题用该目录下 README.md（大小写不敏感）的一级标题；
    // 没有则退回目录名。目录名显示为灰色副标题。
    "UseTitleAsSectionName": true
  }
}
